# Sanity (required for next build and Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional. Defaults to 2026-04-28.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-04-28

# Canonical site origin (metadata, Open Graph, sitemap, robots). Use the production URL in deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Viewer token for draft preview and Presentation (Sanity: API > Tokens > Viewer)
SANITY_API_READ_TOKEN=

# Editor token for contact submissions and newsletter signups (Sanity: API > Tokens > Editor)
SANITY_API_WRITE_TOKEN=

# Signing secret for the Sanity webhook (POST /api/revalidate).
# Sanity signs the body with this value. A query-string secret is ignored.
SANITY_REVALIDATE_SECRET=
